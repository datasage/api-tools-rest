{
    "name": "laminas-api-tools/api-tools-rest",
    "description": "Laminas Module providing structure for RESTful resources",
    "license": "BSD-3-Clause",
    "keywords": [
        "laminas",
        "api-tools",
        "laminas3",
        "module",
        "rest"
    ],
    "homepage": "https://api-tools.getlaminas.org",
    "support": {
        "docs": "https://api-tools.getlaminas.org/documentation",
        "issues": "https://github.com/laminas-api-tools/api-tools-rest/issues",
        "source": "https://github.com/laminas-api-tools/api-tools-rest",
        "rss": "https://github.com/laminas-api-tools/api-tools-rest/releases.atom",
        "chat": "https://laminas.dev/chat",
        "forum": "https://discourse.laminas.dev"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.99"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "laminas": {
            "module": "Laminas\\ApiTools\\Rest"
        }
    },
    "require": {
        "laminas-api-tools/api-tools-api-problem": "^1.10",
        "laminas-api-tools/api-tools-content-negotiation": "^1.11 || ^2.0",
        "laminas-api-tools/api-tools-hal": "^1.13 || ^2.0",
        "laminas-api-tools/api-tools-mvc-auth": "^1.10 || ^2.0",
        "laminas/laminas-eventmanager": "^3.15",
        "laminas/laminas-http": "^2.23 || ^3.0",
        "laminas/laminas-inputfilter": "^2.34",
        "laminas/laminas-mvc": "^3.8 || ^4.0",
        "laminas/laminas-paginator": "^2.21",
        "laminas/laminas-router": "^3.16",
        "laminas/laminas-servicemanager": "^3.24",
        "laminas/laminas-stdlib": "^3.21",
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "^3.1",
        "laminas/laminas-uri": "^2.14",
        "laminas/laminas-view": "^2.43",
        "phpspec/prophecy-phpunit": "^2.3",
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0",
        "psalm/plugin-phpunit": "^0.19",
        "vimeo/psalm": "^6.14"
    },
    "autoload": {
        "psr-4": {
            "Laminas\\ApiTools\\Rest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaminasTest\\ApiTools\\Rest\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "static-analysis": "psalm --shepherd --stats",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    },
    "replace": {
        "zfcampus/zf-rest": "^1.5.0"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-api-problem"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-hal"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-content-negotiation"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-oauth2"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/api-tools-mvc-auth"
        },
        {
            "type": "git",
            "url": "https://github.com/datasage/laminas-mvc"
        }
    ]
}
